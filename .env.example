APP_NAME=finbrief-analyzer
APP_PORT=8000
APP_LOG_LEVEL=INFO

# 수집 API 키. 비워 두면 해당 출처는 건너뛴다 (실제 값은 .env 에만 둔다)
APP_MARKETAUX_TOKEN=
APP_DART_API_KEY=
APP_ECOS_API_KEY=

# 목록형 변수는 JSON 배열로 적는다. 지정하지 않으면 core/config.py 의 기본값을 쓴다
# APP_KR_RSS_FEEDS=["https://www.yna.co.kr/rss/economy.xml"]
# APP_QUOTE_SYMBOLS=[{"symbol":"^KS11","name":"KOSPI","market":"kr"}]
# APP_MARKETAUX_MAX_CALLS_PER_SLOT=3
# APP_HTTP_TIMEOUT_SECONDS=30
