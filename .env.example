APP_NAME=finbrief-analyzer
APP_PORT=8000
APP_LOG_LEVEL=INFO

# 수집 API 키. 비워 두면 해당 출처는 건너뛴다 (실제 값은 .env 에만 둔다)
APP_MARKETAUX_TOKEN=
APP_DART_API_KEY=
APP_ECOS_API_KEY=

# 목록형 변수는 JSON 배열로 적는다. 지정하지 않으면 core/config.py 의 기본값을 쓴다
# APP_KR_RSS_FEEDS=["https://www.yna.co.kr/rss/economy.xml"]
# APP_QUOTE_SYMBOLS=[{"symbol":"^KS11","name":"KOSPI","market":"kr"}]
# 관심 종목. 지정하지 않으면 국내·미국 시가총액 상위 10개씩이다. 빈 배열이면 싣지 않는다
# APP_WATCHLIST=[{"symbol":"005930","name":"삼성전자","market":"kr_stock"},{"symbol":"NVDA","name":"엔비디아","market":"us_stock"}]
# APP_MARKETAUX_MAX_CALLS_PER_SLOT=3
# APP_HTTP_TIMEOUT_SECONDS=30

# 발송 (Gmail 앱 비밀번호. 실제 값은 .env 에만 둔다). 비워 두면 발송 작업이 시작할 때 오류를 낸다
APP_SMTP_USER=
APP_SMTP_PASSWORD=
# APP_SMTP_HOST=smtp.gmail.com
# APP_SMTP_PORT=587
# APP_MAIL_FROM_NAME=finbrief
# 브리핑을 아예 못 보냈을 때 알림을 받을 주소
# APP_OPERATOR_EMAIL=

# DB (브리핑 발송 작업이 쓴다. 비워 두면 웹 앱은 DB 없이 뜬다). 로컬 값은 compose.yml 과 같다
# APP_DB_HOST=localhost
# APP_DB_PORT=5432
# APP_DB_NAME=finbrief_analyzer
# APP_DB_USER=finbrief_analyzer
# APP_DB_PASSWORD=localdev

# 조건 충족 종목 (스크리닝). 처음 한 번 일봉 이력을 받은 뒤에 켠다:
#   uv run python -m finbrief_analyzer.jobs.backfill_prices
# APP_SCREEN_ENABLED=true
# APP_SCREEN_TOP=5
